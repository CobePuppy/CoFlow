{
  "name": "coflow",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @coflow/contracts build && concurrently -k \"pnpm --filter @coflow/contracts dev\" \"pnpm --filter @coflow/api dev\" \"pnpm --filter @coflow/web dev\"",
    "build": "pnpm --filter @coflow/contracts build && pnpm --filter @coflow/api build && pnpm --filter @coflow/web build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages tests scripts prisma/seed.ts .prettierrc.json package.json tsconfig.json playwright.config.ts",
    "format": "prettier --write apps packages tests scripts prisma/seed.ts .prettierrc.json package.json tsconfig*.json playwright.config.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:prepare": "tsx scripts/database/prepare-test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "storage:cleanup": "tsx scripts/maintenance/storage-cleanup.ts",
    "backup": "tsx scripts/maintenance/backup.ts",
    "backup:verify": "tsx scripts/maintenance/backup.ts --restore",
    "db:local:status": "tsx scripts/dev/local-db.ts",
    "db:local:start": "tsx scripts/dev/local-db.ts --start",
    "test:architecture": "tsx --test tests/unit/architecture.test.ts",
    "release:package": "node scripts/release/package.mjs",
    "postinstall": "pnpm --filter @coflow/contracts build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0",
    "@coflow/contracts": "workspace:*"
  }
}
