generator client {
  provider = "prisma-client-js"
}

model GitHubAccount {
  userId String @id
  login String?
  credentials String?
  attempt String?
}

model TaskGitHub {
  taskId String @id
  version Int @default(1)
  data Json
}

model ProjectGitHub {
  projectId String @id
  version Int @default(1)
  data Json
}

model ProjectFork {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  title String
  goal String
  criterion String
  version Int @default(1)
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
}

model ProjectGoal {
  id String @id @default(uuid())
  projectId String
  workspaceId String
  title String
  description String
  criteria String[]
  ownerId String
  dueDate String?
  status String @default("ACTIVE")
  version Int @default(1)
  events Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId,status])
}
model ProjectGoalTask {
  goalId String
  taskId String
  @@id([goalId,taskId])
  @@index([taskId])
}
model ProjectGoalIteration {
  goalId String
  iterationId String
  @@id([goalId,iterationId])
  @@index([iterationId])
}

model ProjectAction {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  taskId String
  sourceKey String
  sourceVersion Int
  title String
  acceptance String
  evidence String
  ownerId String?
  dueDate String?
  status String @default("OPEN")
  outcome String @default("")
  createdBy String
  version Int @default(1)
  events Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId,sourceKey])
  @@index([projectId,status])
}

model ProjectCheckpoint {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  createdBy String
  note String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([projectId,createdAt])
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String
}
model QQBinding {
  workspaceId String
  userId String
  qq String
  createdAt DateTime @default(now())
  @@id([workspaceId,userId])
  @@unique([workspaceId,qq])
}
model QQBindingCode {
  hash String @id
  workspaceId String
  userId String
  expiresAt DateTime
  @@unique([workspaceId,userId])
}
model Session {
  hash String @id
  userId String
  csrf String
  expiresAt DateTime
}
model Workspace {
  id String @id @default(uuid())
  name String
}
model TeamCode {
  workspaceId String @id
  code String @unique
}
model WorkspaceMember {
  workspaceId String
  userId String
  role String @default("MEMBER")
  displayName String?
  @@id([workspaceId,userId])
}
model Invitation {
  id String @id @default(uuid())
  workspaceId String
  email String
  hash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
}
model Project {
  id String @id @default(uuid())
  workspaceId String
  name String
  description String @default("")
  archivedAt DateTime?
  sequence Int @default(0)
  workflow String @default("STANDARD")
  roleMode String @default("STANDARD")
  qualityGate String @default("REMIND")
  @@index([workspaceId])
}
model ProjectMember {
  projectId String
  userId String
  roles String[]
  @@id([projectId,userId])
}
// Append-only revision arrays are held inside the versioned task aggregate.
// Every mutation uses a conditional version update inside a database transaction.
model Task {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  number Int
  status String @default("DRAFT")
  version Int @default(1)
  deletedAt DateTime?
  deletedBy String?
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId,number])
  @@index([projectId,status])
  @@index([projectId,deletedAt])
  @@index([workspaceId,updatedAt])
}
model Document {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  title String
  content String
  taskIds String[]
  version Int @default(1)
  revisions Json
  updatedAt DateTime @updatedAt
  @@index([projectId])
}
model Attachment {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  taskId String?
  key String @unique
  name String
  mime String
  size Int
  userId String
  createdAt DateTime @default(now())
  stage String @default("GENERAL")
  stageVersion Int?
  deletedAt DateTime?
  deletedBy String?
}
model Notification {
  id String @id @default(uuid())
  recipientId String
  workspaceId String
  projectId String
  taskId String
  discussionId String?
  message String
  dedupe String @unique
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([recipientId,readAt,createdAt])
}
model SavedView {
  id String @id @default(uuid())
  workspaceId String
  userId String
  name String
  view String
  mode String
  projectId String?
  filters Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,userId,name])
  @@index([userId,workspaceId])
}
model AuditEvent {
  id String @id @default(uuid())
  workspaceId String
  resourceId String
  actorId String
  action String
  createdAt DateTime @default(now())
}
model IdempotencyRecord {
  id String @id @default(uuid())
  userId String
  key String
  digest String
  result Json
  expiresAt DateTime
  @@unique([userId,key])
}

model RequirementTemplate {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  name String
  content Json
  active Boolean @default(true)
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId,name])
  @@index([projectId,active])
}

model Competition {
  id String @id @default(uuid())
  workspaceId String
  projectId String
  name String
  organizer String @default("")
  url String @default("")
  deadline String @default("")
  stage String @default("PREPARING")
  outcome String @default("")
  notes String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId,stage])
}

model UserSettings {
 userId String @id
 encryptedKey String?
 keyHint String?
 model String @default("deepseek-flash")
 slides Int @default(12)
 minutes Int @default(8)
 preferredEdition String @default("student")
 version Int @default(1)
 updatedAt DateTime @updatedAt
}

model ProofBoard {
 competitionId String @id
 workspaceId String
 projectId String
 version Int @default(1)
 data Json
 updatedAt DateTime @updatedAt
 @@index([projectId])
}

model QQIntegration {
 workspaceId String @id
 tokenHash String?
 tokenHint String?
 enabled Boolean @default(false)
 pushEnabled Boolean @default(true)
 pushTimes String @default("09:00,18:00")
 webUrl String
 version Int @default(1)
 updatedAt DateTime @updatedAt
}

// Standalone files do not inherit project membership or project archive state.
model SpaceFile {
  id String @id @default(uuid())
  scope String
  ownerId String?
  workspaceId String?
  userId String
  key String @unique
  name String
  mime String
  size Int
  version Int @default(1)
  contentVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedBy String?
  @@index([ownerId,deletedAt,createdAt])
  @@index([workspaceId,deletedAt,createdAt])
}
model SpaceFileRevision {
  id String @id @default(uuid())
  fileId String
  number Int
  key String
  name String
  mime String
  size Int
  summary String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([fileId,number])
  @@index([key])
}
model SpaceFileEvent {
  id String @id @default(uuid())
  fileId String
  actorId String
  action String
  createdAt DateTime @default(now())
  @@index([fileId,createdAt])
}

// References are separate from task snapshots, so project forks do not copy grants.
model TaskResource {
 id String @id @default(uuid())
 taskId String
 kind String
 sourceId String
 sourceVersion Int
   fileVersion Int?
 title String
 sourceScope String
 personalShared Boolean @default(false)
 createdBy String
 taskTitle String
 createdAt DateTime @default(now())
 @@unique([taskId,kind,sourceId])
 @@index([sourceId,kind])
}

model Iteration {
 id String @id @default(uuid())
 workspaceId String
 projectId String
 name String
 goal String
 ownerId String
 startDate String
 endDate String
 version Int @default(1)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([projectId,endDate])
}
model IterationMilestone {
 id String @id @default(uuid())
 iterationId String
 name String
 goal String @default("")
 dueDate String
 createdAt DateTime @default(now())
 @@unique([id,iterationId])
 @@index([iterationId,dueDate])
}
model IterationTask {
 id String @id @default(uuid())
 iterationId String
 taskId String @unique
 milestoneId String?
 delayNote String @default("")
 createdBy String
 createdAt DateTime @default(now())
 @@index([iterationId,milestoneId])
}
model IterationEvent {
 id String @id @default(uuid())
 iterationId String
 actorId String
 action String
 data Json
 createdAt DateTime @default(now())
 @@index([iterationId,createdAt])
}
