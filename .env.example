DATABASE_URL=postgresql://USER:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/coflow
PORT=3001
APP_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
SEED_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
# Only for explicitly isolated integration tests:
TEST_DATABASE_URL=postgresql://USER:REPLACE_WITH_TEST_DATABASE_PASSWORD@localhost:5432/coflow_test
TEST_SEED_PASSWORD=REPLACE_WITH_TEST_PASSWORD
# QQ Agent bridge (disabled until both token and team ID are configured):
# QQ_BOT_TOKEN=<random token, at least 32 characters>
# QQ_BOT_WORKSPACE_ID=<Workspace UUID>
# QQ_BOT_WEB_URL=https://your-coflow-site.example
# Optional backup tools (pg_dump / pg_restore must be installed):
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# BACKUP_DIR=./backups/manual
# RESTORE_DATABASE_URL=postgresql://USER:REPLACE_WITH_RESTORE_DATABASE_PASSWORD@localhost:5432/coflow_restore
# RESTORE_STORAGE_DIR=./storage-restore

# Stable 32-byte random secret (64 hex); retain securely with backups.
SETTINGS_ENCRYPTION_KEY=
# GitHub App: Contents/Metadata read-only; enable Device flow.
# PR integration additionally needs Pull requests, Checks, Commit statuses read-only.
# Public repositories work without these settings.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
# Optional absolute installation root for nonstandard runtime layouts.
# COFLOW_ROOT=D:/Apps/CoFlow
